    l_shipdate,
    l_quantity,
    l_extendedprice,
    l_discount,
    l_tax,
    l_extendedprice * (1 - l_discount) as line_total,
    l_extendedprice * (1 - l_discount) * (1 - l_tax) as net_revenue,
    l_commitdate,
    l_receiptdate
from "tpch"."main"."stg_main_lineitem"

    

    );
  
  
  
