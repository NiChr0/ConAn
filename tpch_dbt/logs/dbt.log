    create  table
      "tpch"."main"."fct_lineitem"
  
    as (
      -- Fact: fct_lineitem


select
    md5(cast(coalesce(cast(l_orderkey as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as fct_lineitem_sk,
    l_orderkey,
    l_partkey,
